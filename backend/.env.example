# VibeShift backend configuration
# Copy to .env and adjust as needed.

# Port the API server listens on
VIBESHIFT_PORT=8000

# MongoDB connection (docker compose up -d starts it).
# If unreachable, the app falls back to a local JSON store automatically.
VIBESHIFT_MONGO_URI=mongodb://localhost:27017
VIBESHIFT_MONGO_DB=vibeshift

# Directory where tracks_features.csv must be placed
VIBESHIFT_DATA_DIR=./data
